<section class="block action-matrix-block">
  <h2>Action matrix</h2>
  <table class="action-matrix">
    <thead><tr><th>Zone</th><th>Label</th><th>Action</th></tr></thead>
    <tbody>
      {% for r in action_matrix %}
      <tr>
        <td class="zone-cell"><span class="band-chip {% if r.zone == '4' %}vhigh{% elif r.zone == '3' %}high{% elif r.zone == '2' %}med{% else %}low{% endif %}">Zone {{ r.zone }}</span> {{ r.label }}</td>
        <td colspan="2">{{ r.action }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
