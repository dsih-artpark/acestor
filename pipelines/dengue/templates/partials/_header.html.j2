<header class="brief-head">
  <div class="head-left">
    <h1>{{ document_title }}</h1>
    <div class="scope">Dengue early-warning brief</div>
  </div>
  <div class="head-right">
    <div class="week">{{ run_date }}</div>
    <div>Generated by acestor</div>
    <div class="beta-flag">Beta — not for operational decisions</div>
    <button type="button" class="print-btn no-print" onclick="window.print()">⤓ Save as PDF</button>
  </div>
</header>
