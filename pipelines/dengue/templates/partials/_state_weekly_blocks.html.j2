{# Reference layout: one block per predicted week, map left + Medium+ regions table right. #}
<section class="block weekly-blocks">
  <h2>4-week {{ region_label }} risk progression</h2>
  <div class="subhead">Map + {{ region_label }} list for each forecast week. {{ region_label_plural | title }} at Medium or above are listed.</div>
  {% for blk in weekly_blocks %}
  <div class="weekly-block">
    <h3 class="weekly-label">{{ blk.week_label_pretty }}</h3>
    <div class="two-col">
      <div class="map-frame"><img src="{{ blk.map_relpath }}" alt="risk map" /></div>
      <div>
        {% if blk.rows %}
        <table class="risk-list">
          <thead><tr><th>{{ region_label | title }}</th><th>Band</th><th>Predicted</th><th>Range</th></tr></thead>
          <tbody>
            {% for row in blk.rows %}
            <tr>
              <td class="area">{{ row.regionName }}</td>
              <td><span class="band-chip {{ row.band_class }}">{{ row.band_text }}</span></td>
              <td>{{ row.prediction_int }}</td>
              <td>{{ row.range_low }}–{{ row.range_high }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p class="muted">No Medium+ {{ region_label_plural }} this week.</p>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
</section>
