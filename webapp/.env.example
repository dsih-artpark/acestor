# Postgres
POSTGRES_URL=postgresql+psycopg://acestor:acestor@postgres:5432/acestor

# App
APP_NAME=acestor
APP_LOGO_TEXT=acestor
APP_SUPPORT_URL=

# Auth (Plan A: dev stub, no real auth yet)
# AUTH_PROVIDER: one of {local, google, devstub}. devstub is dev-only (X-Dev-User header path).
AUTH_PROVIDER=local
AUTH_SESSION_SECRET=change-me-in-prod
# Set to true in production (requires HTTPS)
SESSION_COOKIE_SECURE=false

# S3 / MinIO (dev)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=acestor-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# Locale
DEFAULT_TIMEZONE=UTC
