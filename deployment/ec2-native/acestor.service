[Unit]
Description=Acestor Dengue Pipeline Scheduler (native)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Restart=always
RestartSec=30
WorkingDirectory=/opt/acestor
EnvironmentFile=/opt/acestor/.env
ExecStart=/bin/bash /opt/acestor/deployment/ec2-native/run.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
