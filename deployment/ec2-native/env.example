# Pipeline runtime
RUN_ID=
PIPELINE_SPEC=pipelines.gba_dengue.pipeline:build_pipeline
CONFIG_PATH=configs/ap_district.yaml

# AWS credentials (leave blank if using IAM instance role)
AWS_PROFILE=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 data sources (if using S3 backend)
RAW_CASE_BUCKET=
RAW_CASE_PREFIX=
RAW_WEATHER_BUCKET=
RAW_WEATHER_PREFIX=
ARTIFACTS_BUCKET=
ARTIFACTS_PREFIX=acestor/runs

# Email notifications (optional)
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
