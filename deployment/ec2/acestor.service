[Unit]
Description=Acestor Dengue Pipeline Scheduler (Docker)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=30
WorkingDirectory=/opt/acestor
ExecStartPre=-/usr/bin/docker stop acestor-scheduler
ExecStartPre=-/usr/bin/docker rm   acestor-scheduler
ExecStart=/usr/bin/docker run \
  --name acestor-scheduler \
  --rm \
  --env-file /opt/acestor/.env \
  -v /opt/acestor/configs:/app/configs:ro \
  -v /opt/acestor/artifacts:/app/artifacts \
  -v /opt/acestor/logs:/app/logs \
  acestor:latest \
  uv run python scripts/run_schedules.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
