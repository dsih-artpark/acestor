# Pipeline runtime
RUN_ID=ec2-run-001
PIPELINE_SPEC=pipelines.dengue.pipeline:build_pipeline
CONFIG_PATH=configs/dengue_s3_env.yaml

# AWS + data config (used by configs/dengue_s3_env.yaml)
AWS_PROFILE=
AWS_REGION=ap-south-1
RAW_CASE_BUCKET=
RAW_CASE_PREFIX=
RAW_WEATHER_BUCKET=
RAW_WEATHER_PREFIX=
ARTIFACTS_BUCKET=
ARTIFACTS_PREFIX=acestor/runs
RUNS_BUCKET=
RUNS_PREFIX=acestor/runs-meta
CASE_SOURCE_KEY=cases_zone_daily.csv

# Optional email
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
