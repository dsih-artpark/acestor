# DataIO API Configuration
# Get your API key from https://dataio.artpark.ai
DATAIO_API_BASE_URL=https://dataio.artpark.ai/api/v1
DATAIO_API_KEY=your_api_key_here
DATAIO_DATA_DIR=data

# DataIO Weather Data Settings
# Dataset name (e.g., era5_sfc for ERA5 surface data)
DATAIO_DATASET_NAME=era5_sfc

# Weather variables to download (comma-separated)
# Common variables: t2m (2m temperature), tp (total precipitation), d2m (2m dewpoint temperature)
DATAIO_WEATHER_VARIABLES=t2m,tp,d2m

# Region specification
# Can be a state ID (e.g., state_29 for Karnataka) or custom GeoJSON
DATAIO_REGION=state_29

# S3 access keys for accessing raw data bucket for ihip
AWS_SECRET_KEY=
AWS_ACCESS_KEY=
